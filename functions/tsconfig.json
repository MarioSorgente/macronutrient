{
  // The `paths` entries let server code import the app's own pure modules —
  // calc, pricing, units, database — so macros and prices are recomputed with
  // the exact same code the browser used, instead of a second copy that drifts.
  //
  // `include` is deliberately narrow: pulling in all of ../src/lib would drag
  // in the browser-only hooks (planView, recent, storage/local) that reference
  // `window`. TypeScript follows real imports from src/ on its own, so only the
  // pure modules ever get compiled.
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "noEmit": true,
    "strict": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["../src/*"],
      "@data/*": ["../data/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "lib"]
}
