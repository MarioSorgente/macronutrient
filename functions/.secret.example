# Emulator-only secret values.
#
# Copy to `.secret.local` (gitignored) before running the emulator suite:
#   cp functions/.secret.example functions/.secret.local
#
# The integration tests in tests/integration/roles.test.ts assert that
# owner@example.com is bootstrapped as an admin, so that address has to be in
# this list for them to pass.
#
# Production does NOT read this file. The real allowlist lives in Secret
# Manager:  firebase functions:secrets:set ADMIN_EMAILS
ADMIN_EMAILS=owner@example.com,boss@negrita.test
