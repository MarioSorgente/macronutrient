# ---------------------------------------------------------------------------
# Mamma Calories — environment configuration
# Copy this file to `.env.local` for local development.
# For production, set the same keys in Vercel → Project → Settings → Env Vars.
#
# LAUNCHING NOW (localStorage, open link): you need NOTHING here. The app runs
# with zero configuration. This file only matters when you switch to Firebase.
# ---------------------------------------------------------------------------

# Storage backend for saved dishes: "local" (default) or "firebase".
# Leave as "local" until you have created a Firebase project and filled in the
# six NEXT_PUBLIC_FIREBASE_* values below.
NEXT_PUBLIC_STORAGE_BACKEND=local

# --- Firebase (only required when NEXT_PUBLIC_STORAGE_BACKEND=firebase) --------
# From Firebase Console → Project settings → Your apps → Web app → SDK config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
