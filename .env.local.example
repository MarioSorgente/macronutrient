# Copy to `.env.local` and fill in. Never commit `.env.local`.
#
# Everything prefixed NEXT_PUBLIC_ is shipped to the browser BY DESIGN — the
# Firebase web config is not a secret. Security comes from firestore.rules and
# from the Cloud Functions, never from hiding these values.

# ---------------------------------------------------------------------------
# Storage backend
# ---------------------------------------------------------------------------
# "local"    — localStorage only (works with no Firebase project at all)
# "firebase" — Cloud Firestore; a signed-in person's plans and dishes are stored
#              under users/{uid}/, and guests still use this device's storage.
#
# Deploy the security rules before switching this on, or every read is denied:
#   firebase deploy --only firestore:rules
NEXT_PUBLIC_STORAGE_BACKEND=firebase

# ---------------------------------------------------------------------------
# Firebase web config
# Firebase console → Project settings → General → Your apps → Web app → Config
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# The tenant this deployment serves. One restaurant for now; the data model is
# already namespaced so a second one is configuration, not a migration.
NEXT_PUBLIC_RESTAURANT_ID=negrita

# ---------------------------------------------------------------------------
# Local development
# ---------------------------------------------------------------------------
# Point Auth, Firestore and Functions at the local emulator suite:
#   firebase emulators:start --only auth,firestore,functions
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# ---------------------------------------------------------------------------
# Dev script only — not used by the app at runtime
# scripts/enrich-from-usda.mjs, for re-checking macros against USDA
# ---------------------------------------------------------------------------
FDC_API_KEY=

# ---------------------------------------------------------------------------
# NOT here: Cloud Functions config
# ---------------------------------------------------------------------------
# Non-secret values live in functions/.env (RESTAURANT_ID, RESTAURANT_TIMEZONE).
# The bootstrap admin allowlist is a real secret and goes to Secret Manager:
#   firebase functions:secrets:set ADMIN_EMAILS
# Never commit a service-account JSON — local dev uses the emulator, and
# deploys use the Firebase CLI's own credentials.
